<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/about_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/bebas_neue_regular"
        android:text="@string/about"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp"
        app:fontFamily="@font/bebas_neue_regular"
        app:layout_constraintBottom_toTopOf="@id/title_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/title_divider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/about_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/about_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/about_scroll_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_divider">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Título Principal -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/bebas_neue_regular"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    app:fontFamily="@font/bebas_neue_regular" />

                <!-- Descripción -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/about_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/bebas_neue_regular"
                    android:text="@string/key_features"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    app:fontFamily="@font/bebas_neue_regular" />

                <!-- Lista de funcionalidades (Material 3 List) container -->
                <LinearLayout
                    android:id="@+id/features_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"></LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/bebas_neue_regular"
                    android:text="@string/website"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    app:fontFamily="@font/bebas_neue_regular" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrimaryWeb"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/author"
                    android:textAlignment="textStart"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:fontFamily="@font/spacemono_bold"
                    app:icon="@drawable/link"
                    app:iconTint="?attr/colorOnPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/bebas_neue_regular"
                    android:text="@string/credits_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    app:fontFamily="@font/bebas_neue_regular" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/credits_intro"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <!-- PixelXpert -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/credit_pixelxpert_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreditPixelXpert"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/credit_pixelxpert_btn"
                    android:textAlignment="textStart"
                    android:textColor="?attr/colorOnTertiary"
                    android:textSize="14sp"
                    app:backgroundTint="?attr/colorTertiary"
                    app:fontFamily="@font/spacemono_bold"
                    app:icon="@drawable/code"
                    app:iconTint="?attr/colorOnTertiary" />

                <!-- XposedBridge -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/credit_xposed_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreditXposed"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/credit_xposed_btn"
                    android:textAlignment="textStart"
                    android:textColor="?attr/colorOnTertiary"
                    android:textSize="14sp"
                    app:backgroundTint="?attr/colorTertiary"
                    app:fontFamily="@font/spacemono_bold"
                    app:icon="@drawable/code"
                    app:iconTint="?attr/colorOnTertiary" />

                <!-- Vector -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/credit_vector_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreditVector"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/credit_vector_btn"
                    android:textAlignment="textStart"
                    android:textColor="?attr/colorOnTertiary"
                    android:textSize="14sp"
                    app:backgroundTint="?attr/colorTertiary"
                    app:fontFamily="@font/spacemono_bold"
                    app:icon="@drawable/code"
                    app:iconTint="?attr/colorOnTertiary" />

                <!-- Google & Android -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/credit_google_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/bottom_divider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:translationY="-1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/about_scroll_view" />

</androidx.constraintlayout.widget.ConstraintLayout>