    <!-- Bottom Sheet About -->
    <string name="about">Acerca de</string>
    <string name="about_desc">Una utilidad rápida y eficiente diseñada para habilitar la barra de
        tareas (Taskbar) en el launcher nativo de dispositivos Pixel, adaptando la experiencia de
        tablets a tu móvil.</string>
    <string name="key_features">Características Clave</string>
    <string name="website">Sitio web</string>
    <string name="credits_title">Créditos y Agradecimientos</string>
    <string name="credits_intro">Este proyecto es posible gracias a las siguientes contribuciones de
        código abierto y equipos:</string>
    <string name="credit_pixelxpert_desc">PixelXpert / AOSPMods: Equipo original (@siavash79 &amp;
        @ElTifo) de donde se tomó inspiración y código base.</string>
    <string name="credit_xposed_desc">XposedBridge: La creación original de Xposed por @rovo89.</string>
    <string name="credit_vector_desc">Vector: El equipo de Vector (LSPosed) por mantener el entorno
        vivo.</string>
    <string name="credit_google_desc">Google &amp; Android: El sistema operativo Android y el equipo
        de Google.</string>

    <string name="feature_1">Activación de la Taskbar sin modificar el DPI global.</string>
    <string name="feature_2">Personalización de la escala de íconos y carpetas.</string>
    <string name="feature_3">Control sobre la cantidad de aplicaciones en el dock.</string>
    <string name="feature_4">Forzar el estilo de Recientes tipo tablet en móviles.</string>
    <string name="feature_5">Diseño Inferior para mejor alcance de las burbujas.</string>
    <string name="feature_6">Posición personalizable para el botón de cerrar burbujas.</string>

    <!-- Bottom Sheet Instructions -->
    <string name="instructions">Instrucciones</string>
    <string name="instruction_0"><b>Prerrequisitos:</b>\n&#8226; Dispositivo Pixel rooteado (Magisk,
        KernelSU)\n&#8226; Entorno Zygisk activo\n&#8226; Entorno Xposed instalado (LSPosed, Vector,
        etc.)\n\n<b>Nota:</b> Para las funciones de burbujas, asegúrate de marcar <i>System UI</i>
        en las opciones de Xposed.</string>
    <string name="instruction_1">1. Abre Xposed (<a href="https://github.com/JingMatrix/Vector">
        JingMatrix/Vector</a>), activa el módulo y asegúrate de que \'Pixel Launcher\' esté marcado.</string>
    <string name="instruction_2">2. Asegúrate de tener un entorno Zygisk (ej. <a
            href="https://github.com/JingMatrix/NeoZygisk">NeoZygisk</a>).</string>
    <string name="instruction_3">3. Concede permisos de root a Pixel Taskbar Enabler desde tu
        gestor, ya sea <a href="https://github.com/tiann/KernelSU">KernelSU</a> o <a
            href="https://github.com/topjohnwu/Magisk">Magisk</a>.</string>
    <string name="instruction_4">4. Activa el interruptor de arriba para habilitar el Taskbar ¡y
        Disfruta!</string>

