    <string name="feature_1">Taskbar activation without modifying the global DPI.</string>
    <string name="feature_2">Icon and folder scale customization.</string>
    <string name="feature_3">Control over the number of apps in the dock.</string>
    <string name="feature_4">Force tablet-style Recents layout on mobile.</string>

    <!-- Bottom Sheet Instructions -->
    <string name="instructions">Instructions</string>
    <string name="instruction_0"><b>Prerequisites:</b>\n&#8226; Rooted Pixel device (Magisk, KernelSU)\n&#8226; Active Zygisk environment\n&#8226; Xposed framework installed (LSPosed, Vector, etc.)</string>
    <string name="instruction_1">1. Open Xposed (<a href="https://github.com/JingMatrix/Vector">JingMatrix/Vector</a>), enable the module and ensure \'Pixel Launcher\' is checked.</string>
    <string name="instruction_2">2. Ensure a Zygisk environment (e.g., <a
            href="https://github.com/JingMatrix/NeoZygisk">NeoZygisk</a>).</string>
    <string name="instruction_3">3. Grant root permissions to Pixel Taskbar Enabler from your
        manager, either <a href="https://github.com/tiann/KernelSU">KernelSU</a> or <a
            href="https://github.com/topjohnwu/Magisk">Magisk</a>.</string>
    <string name="instruction_4">4. Turn on the switch above to enable the Taskbar and Enjoy!</string>

